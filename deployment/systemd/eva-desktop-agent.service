[Unit]
Description=EVA desktop visual presence agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=eva
WorkingDirectory=/opt/eva
EnvironmentFile=/opt/eva/.env
ExecStart=/opt/eva/.venv/bin/python -m desktop_agent.main
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=graphical.target
