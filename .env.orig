# EVA server environment template
#
# Copy this file to .env and replace every CHANGE_ME value:
#   cp .env.example .env
#
# Use plain KEY=value assignments (no shell commands). Never commit the real .env.

# -----------------------------------------------------------------------------
# EVA core
# -----------------------------------------------------------------------------
EVA_HOMEASSISTANT_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiIxOTJmMzA3N2FiMGY0YzczOWExMWQ1ZjFlZWI4Yjc4MCIsImlhdCI6MTc4NzkyNjgxMywiZXhwIjoyMTAzMjg2ODEzfQ.la7RgpnLUZ8pDMbb1fBmoIpUE0tLy5jGy7Nzkdqi22w
EVA_TIMEZONE=Europe/Berlin
EVA_LOG_LEVEL=INFO
EVA_HTTP_DEBUG=false
EVA_PERFORMANCE_LOGGING=false
EVA_PERFORMANCE_DEBUG=false

# Run module self-tests during startup. Disable only after initial verification.
EVA_RUN_MODULE_TESTS=true

# Limits sent to the LLM; these prevent unnecessarily large prompts.
EVA_MAX_HISTORY_MESSAGES=12
EVA_MAX_CONTEXT_CHARS=12000

# Unknown/Visitor identities do not receive private memory when enabled.
EVA_PROFILE_MEMORY_ISOLATION=true

# -----------------------------------------------------------------------------
# Local Ollama models
# -----------------------------------------------------------------------------

EVA_MODEL=qwen2.5:3b-instruct
EVA_WEB_MODEL=mistral-nemo:12b-instruct-2407-q4_K_S
EVA_ROUTER_MODEL=qwen2.5:1.5b
EVA_SEARCH_MODEL=qwen2.5:1.5b
EVA_EMBEDDING_MODEL=nomic-embed-text
EVA_LLM_NUM_CTX=4096

EVA_OLLAMA_KEEP_ALIVE=30m
EVA_OLLAMA_HEALTH_URL=http://127.0.0.1:11434/api/tags

# Maximum wait used by the systemd dependency check.
EVA_DEPENDENCY_TIMEOUT=180

# -----------------------------------------------------------------------------
# PostgreSQL + pgvector RAG
# -----------------------------------------------------------------------------

# Password-based local connection. URL-encode special characters in the password.
EVA_DATABASE_URL=postgresql:///eva

# Alternative after configuring local peer authentication:
# EVA_DATABASE_URL=postgresql:///eva

EVA_RAG_BACKEND=postgres

# 0 means: probe the selected embedding model and use its real dimension.
EVA_EMBEDDING_DIMENSION=0

EVA_RAG_TOP_K=4
EVA_RAG_THRESHOLD=0.45
EVA_RAG_CACHE_TTL=60
EVA_RAG_CACHE_SIZE=256

EVA_DB_POOL_MIN=1
EVA_DB_POOL_MAX=6
EVA_DB_CONNECT_TIMEOUT=3

# -----------------------------------------------------------------------------
# EVA health/control API
# -----------------------------------------------------------------------------

EVA_HEALTH_ENABLED=true

# 0.0.0.0 is required when Sentry/Desktop connect over the LAN.
# Restrict port 8765 to trusted local IPs with the host firewall.
EVA_HEALTH_HOST=0.0.0.0
EVA_HEALTH_PORT=8765

# Generate two different values with: openssl rand -hex 32
# Copy the matching values only to the trusted external clients.
EVA_SERVER_CONTROL_TOKEN=98a7c3f4cb3b689c5eb3239cd663368e1241b761b99186b5f6eee963dd33f4ab
EVA_PRESENCE_TOKEN=0d3f11da9568c6b862779880887b88274eb50e5de9e5834f7c23258bedd11f97

# Remote shutdown remains log-only until explicitly enabled after testing.
EVA_ALLOW_REMOTE_SHUTDOWN=false
EVA_REMOTE_SHUTDOWN_BOOT_GRACE=600

# Local shutdown inhibitors on the EVA server.
EVA_KEEP_AWAKE_FILE=/tmp/eva_keep_awake
EVA_SHUTDOWN_INHIBIT_FILE=/tmp/eva_shutdown_inhibit

# Room/desk reports expire if an external client stops sending heartbeats.
EVA_PRESENCE_REPORT_TTL=30

# Presence reactions never wake or shut down a device. Short absences remain silent.
EVA_PRESENCE_AUTOMATION_ENABLED=true
EVA_PRESENCE_RETURN_BRIEFING_AFTER=900
EVA_PRESENCE_GREETING_COOLDOWN=14400
EVA_MORNING_GREETING_START=05:00
EVA_MORNING_GREETING_END=11:30
EVA_WEATHER_LOCATION=Kissing
EVA_PRESENCE_AUTOMATION_STATE_FILE=data/presence_automation.json

# -----------------------------------------------------------------------------
# Optional desktop agent
# -----------------------------------------------------------------------------

EVA_DESKTOP_AGENT_ENABLED=false
EVA_DESKTOP_CAMERA=0
EVA_DESKTOP_FPS=2
EVA_DESKTOP_FACE_STORE=data/faces.json
EVA_FACE_THRESHOLD=0.82

# Replace EVA_SERVER_LAN_IP with this server's fixed/reserved LAN address.
EVA_DESKTOP_EVA_URL=http://192.168.2.15:8765/presence

# The desktop agent must use the same EVA_PRESENCE_TOKEN as this EVA server.

# -----------------------------------------------------------------------------
# Optional legacy visual_cortex client
# -----------------------------------------------------------------------------

EVA_VISUAL_CORTEX_ENABLED=false
EVA_VISUAL_CAMERA=0
EVA_VISUAL_FPS=2
EVA_VISUAL_SAVE_FRAMES=false
EVA_FACE_STORE=data/faces.json

#-----------------------------------------------------------------------------
# Optional text-to-speech settings
#-----------------------------------------------------------------------------
EVA_TTS_ENABLED=true
EVA_TTS_OUTPUT_FILE=data/tts/eva-xtts.mp3
EVA_TTS_ENGINE=xtts_v2
EVA_TTS_LANGUAGE=de
EVA_TTS_REFERENCE_AUDIO=data/voices/eva-qwen-reference.wav
EVA_VOICE_REFERENCE=data/voices/eva-qwen-reference.wav
EVA_VOICE_LANGUAGE=de
EVA_TTS_DEVICE=cuda
EVA_AUDIO_VOLUME=0.90
EVA_TTS_LOW_VRAM_MODE=true
EVA_TTS_STREAMING=false
EVA_TTS_CACHE_SPEAKER=true
EVA_TTS_CACHE_DIR=voice/cache
EVA_TTS_XTTS_PYTHON=.venv-xtts/bin/python
EVA_TTS_XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
EVA_TTS_XTTS_TIMEOUT=900
EVA_TTS_STREAM_CHUNK_SIZE=20
EVA_TTS_TEMPERATURE=0.85
EVA_TTS_REPETITION_PENALTY=5.0
EVA_TTS_TOP_K=50
EVA_TTS_TOP_P=0.90
EVA_TTS_SPEED=0.90
EVA_TTS_SENTENCE_PAUSE_MS=140
EVA_TTS_GPT_COND_LEN=12
EVA_TTS_GPT_COND_CHUNK_LEN=4
EVA_TTS_FIRST_CHUNK_MIN_WORDS=5
EVA_TTS_FIRST_CHUNK_TARGET_WORDS=8
EVA_TTS_CHUNK_MIN_WORDS=10
EVA_TTS_CHUNK_TARGET_WORDS=18
EVA_TTS_CHUNK_MAX_WORDS=30
EVA_TTS_MAX_CHUNK_WAIT_MS=350
EVA_TTS_QWEN_REFERENCE_TEXT=data/voices/eva-qwen-reference.txt
EVA_TTS_QWEN_PYTHON=.venv-qwen/bin/python
EVA_TTS_QWEN_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
EVA_TTS_QWEN_DEVICE=cuda:0
EVA_TTS_QWEN_DTYPE=float16
EVA_TTS_QWEN_TEMPERATURE=0.65
EVA_TTS_QWEN_TOP_P=0.85
EVA_TTS_QWEN_TOP_K=30
EVA_TTS_QWEN_REPETITION_PENALTY=1.08
EVA_TTS_QWEN_TIMEOUT=900
EVA_TTS_QWEN_RELEASE_OLLAMA=true
EVA_TTS_EXAGGERATION=0.60
EVA_TTS_CFG_WEIGHT=0.35