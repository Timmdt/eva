# Core models (pull them locally with Ollama; no cloud processing)
EVA_MODEL=qwen2.5:3b-instruct
EVA_WEB_MODEL=mistral-nemo:12b-instruct-2407-q4_K_S
EVA_ROUTER_MODEL=qwen2.5:1.5b
EVA_EMBEDDING_MODEL=nomic-embed-text
EVA_OLLAMA_KEEP_ALIVE=30m
EVA_PERFORMANCE_LOGGING=false
EVA_LOG_LEVEL=INFO
EVA_HTTP_DEBUG=false
EVA_HEALTH_ENABLED=false
EVA_HEALTH_HOST=127.0.0.1
EVA_HEALTH_PORT=8765

# PostgreSQL / pgvector. Insert a local password; never commit the real .env.
EVA_DATABASE_URL=postgresql://eva:CHANGE_ME@127.0.0.1:5432/eva
EVA_RAG_BACKEND=postgres
# 0 probes the selected model and creates VECTOR(actual_dimension).
EVA_EMBEDDING_DIMENSION=0
EVA_RAG_TOP_K=4
EVA_RAG_THRESHOLD=0.45
EVA_RAG_CACHE_TTL=60
EVA_RAG_CACHE_SIZE=256
EVA_DB_POOL_MIN=1
EVA_DB_POOL_MAX=6
EVA_DB_CONNECT_TIMEOUT=3

# Sentry defaults are disabled and shutdown is always dry-run.
EVA_SENTRY_ENABLED=false
EVA_TAPO_RTSP_URL=rtsp://USERNAME:PASSWORD@CAMERA_IP:554/stream1
EVA_SERVER_MAC=00:00:00:00:00:00
EVA_SERVER_IP=192.0.2.10
EVA_WOL_BROADCAST=192.0.2.255
EVA_PRESENCE_TIMEOUT=900
EVA_SENTRY_MODE=presence_only
EVA_FACE_RECOGNITION_ENABLED=false
EVA_SENTRY_DETECTION_FPS=2
EVA_SENTRY_FRAME_SCALE=0.5
EVA_WOL_COOLDOWN=120
EVA_HEALTH_URL=http://192.0.2.10:8765/health
EVA_SENTRY_ALLOW_SHUTDOWN=false
EVA_SENTRY_BOOT_GRACE=600
EVA_KEEP_AWAKE_FILE=/tmp/eva_keep_awake
EVA_SHUTDOWN_INHIBIT_FILE=/tmp/eva_shutdown_inhibit

# Visual Cortex. Frames are not persisted by default.
EVA_VISUAL_CORTEX_ENABLED=false
EVA_VISUAL_CAMERA=0
EVA_VISUAL_FPS=2
EVA_VISUAL_SAVE_FRAMES=false
EVA_FACE_STORE=data/faces.json
EVA_FACE_THRESHOLD=0.82
EVA_PROFILE_MEMORY_ISOLATION=false
