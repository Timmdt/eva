# EVA server environment template
#
# Copy this file to .env and replace every CHANGE_ME value:
#   cp .env.example .env
#
# Use plain KEY=value assignments (no shell commands). Never commit the real .env.

# -----------------------------------------------------------------------------
# EVA core
# -----------------------------------------------------------------------------

EVA_TIMEZONE=CHANGE_ME_IANA_TIMEZONE
EVA_LOG_LEVEL=INFO
EVA_HTTP_DEBUG=false
EVA_PERFORMANCE_LOGGING=false

# Run module self-tests during startup. Disable only after initial verification.
EVA_RUN_MODULE_TESTS=true

# Limits sent to the LLM; these prevent unnecessarily large prompts.
EVA_MAX_HISTORY_MESSAGES=12
EVA_MAX_CONTEXT_CHARS=12000

# Unknown/Visitor identities do not receive private memory when enabled.
EVA_PROFILE_MEMORY_ISOLATION=true

# -----------------------------------------------------------------------------
# Local Ollama models
# -----------------------------------------------------------------------------

EVA_MODEL=qwen2.5:3b-instruct
EVA_WEB_MODEL=mistral-nemo:12b-instruct-2407-q4_K_S
EVA_ROUTER_MODEL=qwen2.5:1.5b
EVA_SEARCH_MODEL=qwen2.5:1.5b
EVA_EMBEDDING_MODEL=nomic-embed-text

EVA_OLLAMA_KEEP_ALIVE=30m
EVA_OLLAMA_HEALTH_URL=http://127.0.0.1:11434/api/tags

# Maximum wait used by the systemd dependency check.
EVA_DEPENDENCY_TIMEOUT=180

# -----------------------------------------------------------------------------
# PostgreSQL + pgvector RAG
# -----------------------------------------------------------------------------

# Password-based local connection. URL-encode special characters in the password.
EVA_DATABASE_URL=postgresql://CHANGE_ME_DATABASE_USER:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:5432/CHANGE_ME_DATABASE_NAME

# Alternative after configuring local peer authentication:
# EVA_DATABASE_URL=postgresql:///CHANGE_ME_DATABASE_NAME

EVA_RAG_BACKEND=postgres

# 0 means: probe the selected embedding model and use its real dimension.
EVA_EMBEDDING_DIMENSION=0

EVA_RAG_TOP_K=4
EVA_RAG_THRESHOLD=0.45
EVA_RAG_CACHE_TTL=60
EVA_RAG_CACHE_SIZE=256

EVA_DB_POOL_MIN=1
EVA_DB_POOL_MAX=6
EVA_DB_CONNECT_TIMEOUT=3

# -----------------------------------------------------------------------------
# EVA health/control API
# -----------------------------------------------------------------------------

EVA_HEALTH_ENABLED=true

# 0.0.0.0 is required when Sentry/Desktop connect over the LAN.
# Restrict port 8765 to trusted local IPs with the host firewall.
EVA_HEALTH_HOST=0.0.0.0
EVA_HEALTH_PORT=8765

# Generate two different values with: openssl rand -hex 32
# Copy the matching values only to the trusted external clients.
EVA_SERVER_CONTROL_TOKEN=CHANGE_ME_RANDOM_64_HEX_CONTROL_TOKEN
EVA_PRESENCE_TOKEN=CHANGE_ME_RANDOM_64_HEX_PRESENCE_TOKEN

# Remote shutdown remains log-only until explicitly enabled after testing.
EVA_ALLOW_REMOTE_SHUTDOWN=false
EVA_REMOTE_SHUTDOWN_BOOT_GRACE=600

# Local shutdown inhibitors on the EVA server.
EVA_KEEP_AWAKE_FILE=/tmp/eva_keep_awake
EVA_SHUTDOWN_INHIBIT_FILE=/tmp/eva_shutdown_inhibit

# Room/desk reports expire if an external client stops sending heartbeats.
EVA_PRESENCE_REPORT_TTL=30

# -----------------------------------------------------------------------------
# Optional desktop agent
# -----------------------------------------------------------------------------

EVA_DESKTOP_AGENT_ENABLED=false
EVA_DESKTOP_CAMERA=0
EVA_DESKTOP_FPS=2
EVA_DESKTOP_FACE_STORE=data/faces.json
EVA_FACE_THRESHOLD=0.82

# Replace EVA_SERVER_LAN_IP with this server's fixed/reserved LAN address.
EVA_DESKTOP_EVA_URL=http://EVA_SERVER_LAN_IP:8765/presence

# The desktop agent must use the same EVA_PRESENCE_TOKEN as this EVA server.

# -----------------------------------------------------------------------------
# Optional legacy visual_cortex client
# -----------------------------------------------------------------------------

EVA_VISUAL_CORTEX_ENABLED=false
EVA_VISUAL_CAMERA=0
EVA_VISUAL_FPS=2
EVA_VISUAL_SAVE_FRAMES=false
EVA_FACE_STORE=data/faces.json
